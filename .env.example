PORT=3000
DATABASE_URL=postgres://grad_app:CHANGE_ME@localhost:5432/grad_project
# path to the registration extract CSV (never committed); used once by npm run db:import
IMPORT_CSV=
# signs the session cookie; at least 32 random characters (e.g. openssl rand -hex 32)
JWT_SECRET=
# browser origin allowed to call the API with the session cookie
CORS_ORIGIN=http://localhost:5173
