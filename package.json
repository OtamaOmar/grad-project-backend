{
  "name": "grad-project-backend",
  "version": "1.0.0",
  "description": "Backend for an AI-powered university course offering and academic planning system, supporting course planning, prerequisite management, course offerings, advisor/coordinator workflows, and LLM-based recommendations.",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create --migration-file-language sql",
    "db:check": "node scripts/db-check.js",
    "db:audit": "node scripts/db-audit.js",
    "test:db-audit": "node --test scripts/test-reference-data-audit.js",
    "test:db-credits": "node --test scripts/test-credit-requisite.js",
    "test:db-hours": "node --test scripts/test-component-hours.js",
    "db:seed": "node scripts/db-seed.js",
    "db:import": "node scripts/db-import.js",
    "user:create": "node src/cli/create-staff-user.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OtamaOmar/grad-project-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/OtamaOmar/grad-project-backend/issues"
  },
  "homepage": "https://github.com/OtamaOmar/grad-project-backend#readme",
  "dependencies": {
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.5",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "node-pg-migrate": "^9.0.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9"
  },
  "private": "true"
}
